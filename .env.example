# Example environment variables for local testing / Vercel
# Replace values with your Supabase project credentials

# Preferred: explicit Supabase fields for local testing
SUPABASE_DB_HOST=db.rcmzlebdcgysjdusgexq.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=replace_with_your_real_supabase_password
SUPABASE_DB_SSLMODE=require

# Optional fallback: Postgres connection string (set this in Vercel as DATABASE_URL)
DATABASE_URL=postgresql://postgres:replace_with_your_real_supabase_password@db.rcmzlebdcgysjdusgexq.supabase.co:5432/postgres

# Optional backward-compatible vars
MYSQL_HOST=db.rcmzlebdcgysjdusgexq.supabase.co
MYSQL_USER=postgres
MYSQL_PASSWORD=replace_with_your_real_supabase_password
MYSQL_DB=postgres

# Supabase client (frontend) anon key (if needed for direct client calls)
SUPABASE_ANON_KEY=sb_publishable_jFrs1VM5vhL1vUGIql6cvQ_6UiOpvG2
